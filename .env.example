# ==============================================================================
# AutoSellerAI 환경변수 예시 — Seller OS v2
# ==============================================================================
# 사용법
#   1) 이 파일을 .env 로 복사
#   2) 실제 계정/API 키는 로컬 .env 에만 입력
#   3) .env 수정 후 Streamlit/worker를 완전히 재시작
#
# 데이터 우선순위
#   공급처/판매채널 실데이터 > 판매자 계정 API 기본값 > 아래 fallback
#
# 주의
#   - URL 값에 Markdown 문법([https://...](...))을 넣지 않습니다.
#   - 실제 .env에서는 변수명에 \_ 같은 이스케이프를 넣지 않습니다.
#   - 네이버 Commerce API와 네이버 Search API 자격증명은 서로 다릅니다.
# ==============================================================================

# 01. 애플리케이션 / 보안
APP_NAME=AutoSellerAI
ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# 02. 데이터베이스 / Redis / GUI
DB_PATH=data/autoseller.db
REDIS_URL=redis://redis:6379/0
SELLER_GUI_URL=http://localhost:8501

# 03. 공통 판매자 fallback
SELLER_SUPPORT_PHONE=
SELLER_DEFAULT_SHIPPING_FEE=3000
SELLER_DEFAULT_RETURN_FEE=3000
SELLER_DEFAULT_ORIGIN=
SELLER_DEFAULT_DELIVERY_COMPANY_CODE=

# 04. 네이버 스마트스토어 Commerce API
# NAVER_CLIENT_SECRET은 커머스 API 센터에서 발급한 $2a$... bcrypt salt 형식
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_LOGIN_ID=
NAVER_LOGIN_PW=
NAVER_AFTER_SERVICE_PHONE=
NAVER_ORIGIN_AREA_CONTENT=
NAVER_DELIVERY_COMPANY_CODE=

# 05. 네이버 Search / 쇼핑 가격비교
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 06. 쿠팡 Wing API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
COUPANG_VENDOR_USER_ID=
COUPANG_OUTBOUND_SHIPPING_PLACE_CODE=0
COUPANG_RETURN_CENTER_CODE=
COUPANG_RETURN_ZIP_CODE=
COUPANG_RETURN_ADDRESS=
COUPANG_RETURN_ADDRESS_DETAIL=
COUPANG_COMPANY_CONTACT_NUMBER=
COUPANG_RETURN_CHARGE=0
COUPANG_DELIVERY_COMPANY_CODE=

# 07. 공급처
DOMEGGOOK_API_KEY=
DOMEGGOOK_USER_ID=
DOMEGGOOK_PASSWORD=
DOMEMAI_API_KEY=
ONCHANNEL_LOGIN_ID=
ONCHANNEL_LOGIN_PW=
OWNERCLAN_USERNAME=
OWNERCLAN_PASSWORD=
OWNERCLAN_ENVIRONMENT=production

# 08. AI
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6
OPENAI_API_KEY=

# 09. 상품 이미지 / AI 상세페이지
IMAGE_SOURCE_PAGE_FETCH=true
IMAGE_AI_ENABLED=false
IMAGE_AI_AUTO_GENERATE=false
IMAGE_AI_PROVIDER=openai
IMAGE_AI_MODEL=gpt-image-1
IMAGE_AI_SIZE=1024x1536
IMAGE_AI_QUALITY=medium
IMAGE_AI_DETAIL_COUNT=3
IMAGE_OUTPUT_DIR=data/generated
IMAGE_PUBLIC_BASE_URL=

# 10. 위탁판매 발주 안전
# AutoSellerAI 기본 운영은 무재고 위탁판매입니다.
# false이면 로컬 PurchaseOrder(재고 사입/재발주) 신규 생성을 DB 단계에서 차단합니다.
# 판매채널 주문 → 공급처 고객직배송 발주에는 영향을 주지 않습니다.
INVENTORY_REPLENISHMENT_ENABLED=false

# 11. 상품 선별 / 가격 필터
MIN_MARGIN_PCT=0.15
MIN_PRICE=1000
MAX_PRICE=300000

# 12. SEO · GEO · AEO 검수
SEO_REVIEW_MODE_ENABLED=true
SEO_MIN_KEYWORDS=30
SEO_TITLE_CANDIDATES=8

# 13. 스케줄러
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Seoul

# 14. Threads / Meta OAuth
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_REDIRECT_URI=https://seller.example.com/api/v1/threads/oauth/callback
THREADS_OAUTH_SUCCESS_URL=https://seller.example.com
THREADS_TOKEN_ENCRYPTION_KEY=
THREADS_VERIFY_TOKEN=
THREADS_GRAPH_BASE_URL=https://graph.threads.net
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_CHECK_INTERVAL_SECONDS=21600
THREADS_TOKEN_REFRESH_THRESHOLD_DAYS=7
THREADS_AUTO_REPLY=false

# 15. 클릭 추적 / 구매 귀속 / 수익 피드백
PUBLIC_BASE_URL=
TRACKING_HASH_SALT=
ATTRIBUTION_WINDOW_HOURS=72
ATTRIBUTION_AUTO_ENABLED=true
ATTRIBUTION_RUN_INTERVAL_SECONDS=300
CONTENT_PROFIT_FEEDBACK_ENABLED=true
CONTENT_PROFIT_FEEDBACK_INTERVAL_SECONDS=900
SMARTSTORE_DEFAULT_FEE_RATE=0.055
COUPANG_DEFAULT_FEE_RATE=0.108
SOCIAL_DEFAULT_SHIPPING_COST=3000

# 16. Telegram 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
