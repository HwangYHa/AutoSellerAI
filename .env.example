# ==============================================================================
# AutoSellerAI 환경변수 예시 — Seller OS v3
# ==============================================================================
# 이 파일은 변수 구조와 안전한 기본값만 관리합니다.
# 실제 계정, 비밀번호, API 키, 전화번호, 주소, 토큰은 절대 커밋하지 말고 로컬 .env에만 입력하세요.
#
# 사용법
#   1) cp .env.example .env
#   2) 로컬 .env에 실제 값 입력
#   3) Streamlit / API / worker / scheduler 완전 재시작
#
# 데이터 우선순위
#   공급처/판매채널 실데이터 > 판매자 계정 API 기본값 > 아래 fallback
#
# 주의
#   - URL 값에 Markdown 링크 문법을 넣지 않습니다.
#   - 변수명에 \_ 같은 이스케이프 문자를 넣지 않습니다.
#   - production에서는 SELLER_API_TOKEN 등 보안값을 반드시 설정합니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 01. 애플리케이션 기본 설정
# ------------------------------------------------------------------------------
APP_NAME=AutoSellerAI
ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 02. 보안 / 인증
# ------------------------------------------------------------------------------
SECRET_KEY=
SELLER_API_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 03. 데이터베이스
# ------------------------------------------------------------------------------
# 로컬/단일 PC 기본: SQLite
DB_PATH=data/autoseller.db

# 상용/다중 인스턴스 권장: PostgreSQL
# 예: postgresql+psycopg://autoseller:password@db:5432/autoseller
DATABASE_URL=

# 기존/보조 PostgreSQL 개별 설정
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autoseller
POSTGRES_USER=autoseller
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# 04. Redis / 작업 큐
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 로컬 Python 실행 기준. Docker Compose에서는 redis://redis:6379/0 으로 override합니다.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 05. GUI / 내부 API
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1
SELLER_GUI_URL=http://localhost:8501

# ------------------------------------------------------------------------------
# 06. 공통 판매자 fallback
# 상품/판매채널 API에서 값을 못 가져올 때만 사용
# ------------------------------------------------------------------------------
SELLER_SUPPORT_PHONE=
SELLER_DEFAULT_SHIPPING_FEE=3000
SELLER_DEFAULT_RETURN_FEE=0
SELLER_DEFAULT_ORIGIN=
SELLER_DEFAULT_DELIVERY_COMPANY_CODE=
RETURN_ADDRESS=

# ------------------------------------------------------------------------------
# 07. 네이버 스마트스토어 / Search API
# ------------------------------------------------------------------------------
NAVER_LOGIN_ID=
NAVER_LOGIN_PW=

# Commerce API 자격증명
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_COMMERCE_API_URL=https://api.commerce.naver.com/external

# API 실패 시 fallback
NAVER_AFTER_SERVICE_PHONE=
NAVER_ORIGIN_AREA_CONTENT=
NAVER_DELIVERY_COMPANY_CODE=

# Search / 쇼핑 가격비교 API — Commerce API 자격증명과 별개
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SHOPPING_API_URL=https://openapi.naver.com/v1/search/shop.json

# ------------------------------------------------------------------------------
# 08. 쿠팡 Wing API
# ------------------------------------------------------------------------------
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
COUPANG_VENDOR_USER_ID=
COUPANG_WING_API_URL=https://api-gateway.coupang.com

# Wing API 자동조회 우선 / 실패 시 fallback
COUPANG_OUTBOUND_SHIPPING_PLACE_CODE=0
COUPANG_RETURN_CENTER_CODE=
COUPANG_RETURN_ZIP_CODE=
COUPANG_RETURN_ADDRESS=
COUPANG_RETURN_ADDRESS_DETAIL=
COUPANG_COMPANY_CONTACT_NUMBER=
COUPANG_RETURN_CHARGE=0
COUPANG_DELIVERY_COMPANY_CODE=

# ------------------------------------------------------------------------------
# 09. 공급처 - 오너클랜
# ------------------------------------------------------------------------------
OWNERCLAN_USERNAME=
OWNERCLAN_PASSWORD=
OWNERCLAN_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 10. 공급처 - 도매꾹 / 도매매 / 온채널
# ------------------------------------------------------------------------------
DOMEGGOOK_API_KEY=
DOMEGGOOK_USER_ID=
DOMEGGOOK_PASSWORD=
DOMEMAI_API_KEY=

ONCHANNEL_LOGIN_ID=
ONCHANNEL_LOGIN_PW=
ONCHANNEL_BASE_URL=https://www.onch3.co.kr

# ------------------------------------------------------------------------------
# 11. Claude AI
# ------------------------------------------------------------------------------
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# 12. OpenAI / AI 상세페이지 이미지
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# 공급처 원본 상품 페이지의 img/data-src/srcset까지 추가 수집
IMAGE_SOURCE_PAGE_FETCH=true

# AI 생성 기능 사용 여부. 자동생성은 비용 안전상 기본 OFF
IMAGE_AI_ENABLED=false
IMAGE_AI_AUTO_GENERATE=false
IMAGE_AI_PROVIDER=openai
IMAGE_AI_MODEL=gpt-image-1
IMAGE_AI_SIZE=1024x1536
IMAGE_AI_QUALITY=medium
IMAGE_AI_DETAIL_COUNT=3
IMAGE_OUTPUT_DIR=data/generated
IMAGE_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# 13. 기존 이미지 생성 서비스 / 호환 설정
# 신규 구현은 IMAGE_AI_* 사용을 우선합니다.
# ------------------------------------------------------------------------------
IMAGE_CDN_BASE_URL=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_TOKEN=
IMAGE_GEN_MODEL=pollinations

# ------------------------------------------------------------------------------
# 14. 주문 / 배송 자동화
# ------------------------------------------------------------------------------
# 실제 주문/발주 등 위험 작업은 승인 Gate를 우선합니다.
ORDER_AUTO_APPROVE=false
ORDER_COLLECT_INTERVAL_MIN=5
ORDER_INVOICE_POLL_INTERVAL_MIN=10
CS_AUTO_SEND=false

# ------------------------------------------------------------------------------
# 15. 상품 업로드
# ------------------------------------------------------------------------------
UPLOAD_MAX_RETRIES=3
UPLOAD_RETRY_DELAY=5
UPLOAD_BATCH_SIZE=10
PLAYWRIGHT_HEADLESS=true
HUMAN_DELAY_MIN_MS=500
HUMAN_DELAY_MAX_MS=2000

# ------------------------------------------------------------------------------
# 16. 위탁판매 / 재고 사입 안전
# ------------------------------------------------------------------------------
# false이면 로컬 PurchaseOrder/MOQ 기반 재고 사입 신규 생성을 차단합니다.
# 판매채널 주문 → 공급처 고객직배송 발주에는 영향을 주지 않습니다.
INVENTORY_REPLENISHMENT_ENABLED=false

# ------------------------------------------------------------------------------
# 17. 가격 자동화
# ------------------------------------------------------------------------------
PRICING_INTERVAL_MIN=120
PRICING_MIN_MARGIN_PCT=0.15
PRICING_TARGET_MARGIN_PCT=0.25
PRICING_STRATEGY=balanced
PRICING_MAX_PRICE_DROP_PCT=0.20
PRICING_COUPANG_FEE_PCT=0.107
PRICING_NAVER_FEE_PCT=0.035
PRICING_SHIPPING_COST=2500.0
PRICING_AD_COST_PER_ORDER=500.0

# Seller OS v3 공통 가격 필터
MIN_MARGIN_PCT=0.15
MIN_PRICE=1000
MAX_PRICE=300000

# ------------------------------------------------------------------------------
# 18. 광고 최적화
# ------------------------------------------------------------------------------
AD_TARGET_ROAS=3.0
AD_MAX_ACOS=0.20
AD_BUDGET_DAILY_DEFAULT=10000.0

# ------------------------------------------------------------------------------
# 19. 정산 / 세금
# ------------------------------------------------------------------------------
VAT_RATE=0.10
INCOME_TAX_RATE=0.033

# ------------------------------------------------------------------------------
# 20. 공급처 자동 수집 / 상품 선별
# ------------------------------------------------------------------------------
SUPPLIER_MIN_MARGIN_PCT=0.15
SUPPLIER_MAX_PRICE_KRW=200000
SUPPLIER_MIN_PRICE_KRW=3000
SUPPLIER_ALLOWED_CATEGORIES=
SUPPLIER_AUTO_IMPORT=false
SUPPLIER_SYNC_INTERVAL_MIN=60

# ------------------------------------------------------------------------------
# 21. SEO · GEO · AEO 검수
# ------------------------------------------------------------------------------
SEO_REVIEW_MODE_ENABLED=true
SEO_MIN_KEYWORDS=30
SEO_TITLE_CANDIDATES=8

# ------------------------------------------------------------------------------
# 22. Seller OS v3 안전 Scheduler / RQ
# 위험 작업은 scheduler가 자동 실행하지 않습니다.
# ------------------------------------------------------------------------------
SELLER_SCHEDULER_ENABLED=true
SELLER_ORDER_SYNC_MINUTES=5
SELLER_CATALOG_SYNC_MINUTES=60
SELLER_RECONCILE_MINUTES=30

# 레거시 스케줄러 전환기간 설정
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Seoul

# ------------------------------------------------------------------------------
# 23. Threads / Meta OAuth
# ------------------------------------------------------------------------------
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_REDIRECT_URI=https://seller.example.com/api/v1/threads/oauth/callback
THREADS_OAUTH_SUCCESS_URL=https://seller.example.com
THREADS_TOKEN_ENCRYPTION_KEY=
THREADS_VERIFY_TOKEN=
THREADS_GRAPH_BASE_URL=https://graph.threads.net
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_CHECK_INTERVAL_SECONDS=21600
THREADS_TOKEN_REFRESH_THRESHOLD_DAYS=7
THREADS_AUTO_REPLY=false

# ------------------------------------------------------------------------------
# 24. 클릭 추적 / 구매 귀속 / 실제 순이익 피드백
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL=
TRACKING_HASH_SALT=
ATTRIBUTION_WINDOW_HOURS=72
ATTRIBUTION_AUTO_ENABLED=true
ATTRIBUTION_RUN_INTERVAL_SECONDS=300
CONTENT_PROFIT_FEEDBACK_ENABLED=true
CONTENT_PROFIT_FEEDBACK_INTERVAL_SECONDS=900
SMARTSTORE_DEFAULT_FEE_RATE=0.055
COUPANG_DEFAULT_FEE_RATE=0.108
SOCIAL_DEFAULT_SHIPPING_COST=3000

# ------------------------------------------------------------------------------
# 25. Telegram 알림
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 26. 오류 추적
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 27. A/B 테스트
# ------------------------------------------------------------------------------
AB_TEST_MIN_VIEWS=100
AB_TEST_MIN_CONVERSIONS=10
AB_TEST_SIGNIFICANCE_THRESHOLD=0.95
AB_TEST_CHECK_INTERVAL_MIN=60

# ------------------------------------------------------------------------------
# 28. Stable Diffusion WebUI / AI 인물 이미지 스튜디오
# ------------------------------------------------------------------------------
# AUTOMATIC1111 WebUI를 로컬 Python에서 직접 호출할 때 사용합니다.
SD_WEBUI_URL=http://127.0.0.1:7860

# Docker Compose 안의 AutoSellerAI와 image-worker가 Windows/macOS 호스트의
# Stable Diffusion WebUI를 호출할 때 사용합니다. docker-compose.yml이 이 값을
# 컨테이너의 SD_WEBUI_URL로 주입합니다.
SD_WEBUI_DOCKER_URL=http://host.docker.internal:7860

# WebUI를 --api-auth user:password 로 실행한 경우만 입력합니다.
SD_WEBUI_USERNAME=
SD_WEBUI_PASSWORD=

# 생성 요청/RQ 작업 제한 시간(초). GPU/고해상도 모델에 맞춰 조정 가능합니다.
SD_WEBUI_TIMEOUT_SECONDS=900

# image-worker와 autoseller가 함께 보는 ./data 볼륨 하위 저장 위치입니다.
SD_IMAGE_OUTPUT_DIR=data/generated/stable_diffusion

# WebUI 쪽 실행 예시(설치 방식에 맞게 COMMANDLINE_ARGS에 적용):
#   --api --listen --port 7860
# --listen은 LAN 접근을 열 수 있으므로 Windows 방화벽에서 공용 네트워크 접근을
# 허용하지 말고, 필요하면 --api-auth도 함께 사용하세요.
