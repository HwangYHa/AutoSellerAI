# Existing AutoSellerAI settings may be added below as needed.
DB_PATH=data/autoseller.db
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Threads / Meta OAuth
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_REDIRECT_URI=https://seller.example.com/api/v1/threads/oauth/callback
THREADS_OAUTH_SUCCESS_URL=https://seller.example.com
SELLER_GUI_URL=http://localhost:8501
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THREADS_TOKEN_ENCRYPTION_KEY=
THREADS_VERIFY_TOKEN=change-me
THREADS_GRAPH_BASE_URL=https://graph.threads.net

# Legacy/manual fallback credentials. OAuth-connected encrypted DB credentials take precedence.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Token lifecycle
THREADS_TOKEN_CHECK_INTERVAL_SECONDS=21600
THREADS_TOKEN_REFRESH_THRESHOLD_DAYS=7

# Safety: keep false until webhook + reply rules are verified in production.
THREADS_AUTO_REPLY=false

# Public social-commerce URL used to create tracking links, e.g. https://seller.example.com
PUBLIC_BASE_URL=
# Salt used before storing a one-way hash of click IP addresses. Use a long random value in production.
TRACKING_HASH_SALT=change-this-to-a-long-random-secret
# Social click -> marketplace order attribution.
ATTRIBUTION_WINDOW_HOURS=72
ATTRIBUTION_AUTO_ENABLED=true
ATTRIBUTION_RUN_INTERVAL_SECONDS=300

# Queue
REDIS_URL=redis://redis:6379/0
